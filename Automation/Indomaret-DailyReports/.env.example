# Copy this file to ".env" in the same folder and fill in your own values.
# The .env file stays on this PC. Do not commit it, email it, or paste it into chat.
# Same Indomaret DCP login as the Market Share automation - copy the values from
# ..\Indomaret-MarketShare\.env if you already filled that one in.

INDOMARET_EMAIL=
INDOMARET_PASSWORD=

# Base32 seed from your authenticator app (not the rotating 6-digit code).
# Leave blank to be prompted for the 6-digit code (manual runs only - scheduled
# runs will not work without it).
INDOMARET_TOTP_SECRET=
