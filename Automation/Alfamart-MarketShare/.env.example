# Copy this file to ".env" in the same folder and fill in your own values.
# The .env file stays on this PC. Do not commit it, email it, or paste it into chat.

# Your Alfamart B2B login (the one you type on b2b.alfamart.co.id/login.php)
ALFAMART_USERNAME=<portal-username>
ALFAMART_PASSWORD=

# Base32 seed from Google Authenticator, e.g. JBSWY3DPEHPK3PXP
# This is the secret behind the QR code you scanned when 2FA was set up -
# NOT the 6-digit code that rotates every 30 seconds.
# If you do not have it, see README.md > "Getting your TOTP seed".
# Leave blank to be prompted for the 6-digit code (manual runs only,
# scheduled runs will not work without it).
ALFAMART_TOTP_SECRET=
