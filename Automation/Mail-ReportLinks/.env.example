# Copy to ".env" and adjust. No credentials here - the Power Automate flow does
# the mailbox side, this script only reads files off the synced OneDrive folder.

# Where Power Automate drops email bodies. Must be inside the synced OneDrive
# folder so they actually appear on this PC.
DROP_DIR=D:\OneDrive - PT. Opto Lumbung Sejahtera\Apps\ReportLinks

# Root for downloaded reports. Per-source subfolders come from sources.json.
DEST_ROOT=D:\SCARLETT_512\SCARLETT-329\SOM\Data\Report\Sales\Minimarket

# Seconds to wait on a download. Generated reports can be slow to start.
HTTP_TIMEOUT=120

# Skip anything larger than this, in megabytes.
MAX_MB=200

# How long a link stays good. Past this the script still tries, but warns first
# so an expired link is obvious in run.log rather than a mystery HTTP 403.
LINK_TTL_HOURS=24

# Dead man's switch. If no report email has arrived for this many days, the run
# logs a WATCHDOG error and exits 3, so Task Scheduler's "Last Run Result" turns
# red instead of quietly reporting success. Set this a little longer than your
# longest normal gap between reports - too short and you get cried wolf at, too
# long and a dead flow goes unnoticed.
WATCHDOG_DAYS=3
