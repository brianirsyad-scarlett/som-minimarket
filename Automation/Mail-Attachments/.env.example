# Copy this file to ".env" in the same folder and adjust as needed.
# There are no credentials here - the script reads the Outlook profile that is
# already signed in on this PC. Every value below is optional; the defaults in
# mail_attachments.py apply when a line is blank or missing.

# Mail folder to scan. Use "/" to go deeper, e.g. Inbox/Sales Reports
MAIL_FOLDER=Inbox

# Also scan every subfolder underneath MAIL_FOLDER.
MAIL_INCLUDE_SUBFOLDERS=false

# How far back to look on each run. The scheduled task runs daily, so 7 gives
# a week of overlap - re-saving is harmless because attachments are
# de-duplicated by SHA-256 in state.json.
MAIL_LOOKBACK_DAYS=7

# Where attachments land. Routing into subfolders is configured in rules.json.
MAIL_DEST_ROOT=D:\SCARLETT_512\SCARLETT-329\SOM\Data\Mail Attachments

# Extensions to save. Anything not listed here is ignored.
# Executable types (.exe .dll .lnk .ps1 .js .msi ...) are blocked in code and
# CANNOT be re-enabled from this file.
# Macro-enabled Office types (.xlsm .xlsb .docm ...) are blocked unless you add
# them here explicitly - only do that for senders you actually trust.
MAIL_ALLOWED_EXT=xlsx,xls,csv,pdf,docx,doc,txt,pptx,zip

# Skip anything bigger than this, in megabytes.
MAIL_MAX_MB=50

# Skip inline images (signature logos, pasted screenshots). Leave this on or
# you will collect thousands of 2 KB logo files.
MAIL_SKIP_INLINE=true

# Mark messages as read once their attachments are saved. Off by default so the
# script never modifies the mailbox.
MAIL_MARK_READ=false
