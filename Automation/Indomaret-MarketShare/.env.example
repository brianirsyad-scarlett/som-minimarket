# Copy this file to ".env" in the same folder and fill in your own values.
# The .env file stays on this PC. Do not commit it, email it, or paste it into chat.

# Your Indomaret DCP / B2B login email
INDOMARET_EMAIL=<login-email>

# Your Indomaret DCP / B2B password
INDOMARET_PASSWORD=<password>

# Base32 seed from your authenticator app, e.g. JBSWY3DPEHPK3PXP
# This is the secret behind the QR code you scanned when 2FA was first enrolled -
# NOT the 6-digit code that rotates every 30 seconds.
# If you do not have it, you must re-enroll 2FA on the Indomaret portal and copy
# the text key this time before scanning.
# Leave blank to be prompted for the 6-digit code (manual runs only - scheduled
# runs will not work without it).
INDOMARET_TOTP_SECRET=<base32-totp-seed>
